{
  "name": "pickleplay-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web && printf '/*    /index.html   200\\n' > dist/_redirects && node scripts/postbuild-pwa.js",
    "build:mumbai": "EXPO_PUBLIC_LEAGUE_ID=69776e9d-62b7-43a9-95a1-cecb24647b7b expo export --platform web --output-dir dist-mumbai --clear && printf '/*    /index.html   200\\n' > dist-mumbai/_redirects && node scripts/postbuild-pwa.js dist-mumbai"
  },
